# Server-only OpenAI credentials for receipt scanning. Never use a VITE_ prefix.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
# Optional: a vision + Structured Outputs model supporting low reasoning effort.
OPENAI_MODEL="gpt-5.6-luna"

# APP_URL: The URL where this applet is hosted.
# Keep your existing application URL, if configured.
APP_URL="MY_APP_URL"

VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Server-only; required for admin user creation. Never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=""
